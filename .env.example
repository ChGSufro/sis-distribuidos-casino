# =========================================================
# Sistema de Casino Online - variables de entorno
# Copiar a .env y ajustar. El archivo .env NO se versiona.
#   cp .env.example .env
# =========================================================

# ---- API Gateway ----
GATEWAY_PORT=8080

# ---- Auth & Users Service ----
USERS_GRPC_PORT=50056
USERS_DB_USER=casino
USERS_DB_PASSWORD=casino
USERS_DB_NAME=users_db
JWT_SECRET=dev-secret-change-me
ACCESS_TTL=15m
REFRESH_TTL=168h

# ---- Wallet Service ----
WALLET_GRPC_PORT=50051
WALLET_DB_USER=casino
WALLET_DB_PASSWORD=casino
WALLET_DB_NAME=wallet_db

# ---- Blackjack Game Service ----
BLACKJACK_GRPC_PORT=50052
MONGO_BLACKJACK_DB=bj_state_db

# ---- Poker Game Service ----
POKER_GRPC_PORT=50055
MONGO_POKER_DB=poker_state_db

# ---- History & Audit Service ----
HISTORY_GRPC_PORT=50053
MONGO_HISTORY_DB=audit_history_db

# ---- Leaderboard & Stats Service ----
STATS_GRPC_PORT=50054
MONGO_STATS_DB=stats_db
