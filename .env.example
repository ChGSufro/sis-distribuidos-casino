# Variables de Entorno para Docker Compose - Casino Distribuido

# Wallet Service & PostgreSQL (Chris)
WALLET_PORT=50051
WALLET_DB_PORT=5434
WALLET_DB_USER=casino_user
WALLET_DB_PASSWORD=casino_pass
WALLET_DB_NAME=wallet_db
WALLET_DB_SSLMODE=disable

# Blackjack Game Service & MongoDB (Chris)
BJ_PORT=50052
BJ_DB_PORT=27017
BJ_DB_USER=casino_user
BJ_DB_PASSWORD=casino_pass
BJ_DB_NAME=bj_state_db
HISTORY_SERVICE_URL=history:50053

# Users & Auth Service (Alex Sáez)
USERS_GRPC_PORT=50056
USERS_DB_USER=casino
USERS_DB_PASSWORD=casino
USERS_DB_NAME=users_db
JWT_SECRET=dev-secret-change-me
ACCESS_TTL=15m
REFRESH_TTL=168h

# Poker Service (Alex Sáez)
POKER_GRPC_PORT=50055
MONGO_POKER_DB=poker_state_db
